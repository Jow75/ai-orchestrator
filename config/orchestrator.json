{
  "$comment": "Global AI-Orchestrator settings. Every key is optional — anything omitted falls back to the documented default (see CONFIGURATION.md). Edit this file, never the code.",

  "logging": {
    "level": "info",
    "console": true,
    "file": true,
    "maxFiles": "14d",
    "maxSize": "10m"
  },

  "api": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 4711
  },

  "progress": {
    "$comment": "Loop prevention. maxConsecutiveNoProgress runs that change nothing trip the circuit breaker and stop with a diagnostic report. This is what prevents overnight quota burn.",
    "enabled": true,
    "maxConsecutiveNoProgress": 3,
    "interRunDelayMs": 15000,
    "blockedDetection": true
  },

  "notifications": {
    "events": [
      "session:rate-limited",
      "session:crashed",
      "session:gave-up",
      "mission:blocked",
      "mission:complete",
      "orchestrator:recovered-after-reboot",
      "approval:required",
      "human-action:required",
      "task:verification-failed",
      "release:created",
      "summary:daily",
      "summary:weekly"
    ],
    "desktop": { "enabled": true },
    "webhook": { "enabled": false, "url": "" },
    "discord": { "enabled": false, "webhookUrl": "" },
    "telegram": { "enabled": false, "botToken": "", "chatId": "" },
    "email": { "enabled": false }
  },

  "defaultProject": ""
}
