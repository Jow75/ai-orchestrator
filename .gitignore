# Dependencies
node_modules/

# Runtime data (never commit live state)
# Anchored to the repo root (leading /) — an unanchored "state/" also matched
# src/state/, silently excluding the entire session/status persistence layer
# from every commit since P0. Never unanchor these again.
/logs/
/state/
/sessions/
/status.json
*.log

# Atomic-write temp files (should be cleaned up automatically; ignore any strays)
.status.json.*.tmp
*.tmp

# Environment / local overrides
.env
config/local.json

# Local project instances. The documented workflow (see config/projects/
# example.json) is to copy example.json to <your-project>.json; those are
# per-machine (absolute working directories, real prompts) and stay local,
# like config/local.json. Only the shared template is tracked.
/config/projects/*
!/config/projects/example.json

# Operator-owned schedule definitions, edited at runtime via `schedules add`.
# The machine-owned run tracking in state/schedules.json is already ignored.
config/schedules.json

# Credentials handed over out-of-band (never commit plaintext secrets)
*credentilas*.txt
*credentials*.txt

# OS noise
Thumbs.db
.DS_Store

# Coverage / build output
coverage/
dist/
