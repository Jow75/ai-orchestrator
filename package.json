    "node-notifier": "^10.0.1",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.5.0",
    "jsdoc": "^4.0.3",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
